{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/auth_service/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/auth_service/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/auth_service",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "auth_service": {
      "type": "application",
      "root": "apps/auth_service",
      "entryFile": "main",
      "sourceRoot": "apps/auth_service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth_service/tsconfig.app.json"
      }
    },
    "booking_service": {
      "type": "application",
      "root": "apps/booking_service",
      "entryFile": "main",
      "sourceRoot": "apps/booking_service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/booking_service/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "notification_service": {
      "type": "application",
      "root": "apps/notification_service",
      "entryFile": "main",
      "sourceRoot": "apps/notification_service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification_service/tsconfig.app.json"
      }
    },
    "payment_service": {
      "type": "application",
      "root": "apps/payment_service",
      "entryFile": "main",
      "sourceRoot": "apps/payment_service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/payment_service/tsconfig.app.json"
      }
    },
    "provider_service": {
      "type": "application",
      "root": "apps/provider_service",
      "entryFile": "main",
      "sourceRoot": "apps/provider_service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/provider_service/tsconfig.app.json"
      }
    },
    "rmq": {
      "type": "library",
      "root": "libs/rmq",
      "entryFile": "index",
      "sourceRoot": "libs/rmq/src",
      "compilerOptions": {
        "tsConfigPath": "libs/rmq/tsconfig.lib.json"
      }
    }
  }
}